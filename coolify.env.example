# ============================================================
# EmpMonitor — Coolify Environment Variables
# Paste these into the Coolify app > Environment Variables (bulk edit),
# replace the values marked <generate> / <domain> and save.
# ============================================================

# ---- Timezone ----
TIMEZONE=America/Hermosillo

# ---- MySQL ----
MYSQL_DATABASE=empmonitor
MYSQL_USERNAME=empmonitor
MYSQL_PASSWORD=<generate-32>
MYSQL_ROOT_PASSWORD=<generate-32>

# ---- MongoDB ----
# App user (created by docker/mongo-init.js inside the empmonitor db)
MONGO_DATABASE=empmonitor
MONGO_USERNAME=empmonitor
MONGO_PASSWORD=<generate-32>
# Admin root user
MONGO_ROOT_PASSWORD=<generate-32>

# ---- Redis ----
REDIS_PASSWORD=<generate-32>

# ---- Shared secrets (MUST be identical across all services) ----
# CRYPTO_PASSWORD: max 32 chars (AES-256 key). VITE_CRYPTO_PASSWORD must match.
CRYPTO_PASSWORD=<generate-32-max>
SESSION_SECRET=<generate-48>
JWT_ACCESS_TOKEN_SECRET=<generate-48>
JWT_REFRESH_TOKEN_SECRET=<generate-48>
JWT_SECRET=<generate-48>
SWAGGER_PASSWORD=<generate-16>

# ---- Public URLs (Traefik domains -> 192.168.0.206) ----
PUBLIC_WEB_URL=https://empmonitor.mefasa
PUBLIC_API_URL=https://empmonitor-api.mefasa
PUBLIC_AGENT_URL=https://empmonitor-agent.mefasa

# ---- Frontend build args (baked into the Vite bundle) ----
VITE_API_URL=https://empmonitor-api.mefasa/api/v3
VITE_SOCKET_URL=wss://empmonitor-ws.mefasa/notification/websocket
VITE_BACKEND_V4_URL=https://empmonitor-api.mefasa
VITE_CRYPTO_PASSWORD=<same-as-CRYPTO_PASSWORD>
VITE_PASSWORD_IV=<generate-16-max>
VITE_ADDON_SUPERADMIN_ORG_ID=

# ---- Mail (optional — alerts/reports by email) ----
SENDGRID_API_KEY=
SMTP_URL=
GMAIL_EMAIL=
GMAIL_PASSWORD=
EMP_ADMIN_EMAIL=admin@mefasa.org

# ---- Jenkins agent-build pipeline (leave empty on-premise) ----
JENKINS_URL=
JENKINS_AUTH_USERNAME=
JENKINS_AUTH_PASSWORD=
BUILD_API_URL=
